{
  // 用 pyright / ruff / mypy 之类命令行工具时的等价配置。
  //
  // 为什么需要：这些脚本靠 `sys.path.insert` 导入兄弟目录里的模块
  // （dogwood_client 在 python-demo/，scenario 在 opa-vs-dogwood/），
  // 静态分析不会执行那行代码，于是报"找不到模块"。
  // 路径是相对**本文件所在目录**（python-demo/）的。
  "extraPaths": [
    ".",
    "hsbc",
    "opa-vs-dogwood",
    "opa-vs-dogwood/dogwood",
    "opa-vs-dogwood/opa"
  ],
  "include": ["."],
  "exclude": ["**/__pycache__"]
}
