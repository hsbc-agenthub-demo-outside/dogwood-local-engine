// 两条授权：审批本身总是允许；退款必须有"同一金额、一小时内、已批准"的历史。
//
// 注意 deny by default：没有 permit 覆盖的动作一律拒绝。所以 `approve` 这条
// permit 不是装饰 —— 少了它，审批工具本身会被拒，退款永远等不到历史。
//
// 动作名必须**逐字**等于工具名（`approve` / `refund`）。大小写差一个字母，
// 策略就永远匹配不上，表现是"所有请求都被拒"—— 这个 demo 第一次跑就是这么挂的。

@id("allow_approve")
permit (principal, action == AgentCore::Action::"approve", resource);

// 读法：最近 1 小时内存在一个 approve 的 response，其 input.amount 等于当前
// 退款请求的 context.input.amount，且它的 output.approved 为 true。
@id("refund_needs_approval")
permit (principal, action == AgentCore::Action::"refund", resource)
when temporal {
    formerly within 1h AgentCore::Action::"approve"::response{
        input.amount: context.input.amount,
        output.approved: true
    }
};
